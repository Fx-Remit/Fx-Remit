# Copy to .env.local and fill values. Never commit secrets.

# Database
DATABASE_URL=
DIRECT_URL=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WEBHOOK_SECRET=
# Instant Send: authorization private key (wallet-auth:…) + matching key quorum / policy
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Client: key quorum id from Privy Dashboard (e.g. mi1bf…)
NEXT_PUBLIC_PRIVY_KEY_QUORUM_ID=
# Client: Instant Send USDC policy id (required — empty policyIds grants unrestricted signing)
NEXT_PUBLIC_PRIVY_POLICY_ID=
# Client: Crypto cash-out Instant Send policy id (Base/Celo USDC/USDT, separate cap from bank Instant Send)
NEXT_PUBLIC_PRIVY_POLICY_ID_CRYPTO=

# Bank payouts through PayoutForwarder (server-only; never NEXT_PUBLIC_).
# The relayer key only pays gas and calls payout(); keep it secret.
RELAYER_PRIVATE_KEY=
PAYOUT_FORWARDER_ADDRESS=
# Off by default. While off, only users in the comma-separated allowlist (app user id or Privy DID) use it.
PAYOUT_FORWARDER_ENABLED=false
PAYOUT_FORWARDER_ALLOWLIST=
BASE_RPC_URL=

# Bank payout pricing (server-only; never NEXT_PUBLIC_). Integer basis points.
# PAYOUT_FEE_BPS is the fee users see; PAYOUT_SPREAD_BPS is built into the displayed rate.
PAYOUT_FEE_BPS=
PAYOUT_SPREAD_BPS=

# Alchemy RPC + Notify (Address Activity)
NEXT_PUBLIC_ALCHEMY_API_KEY=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_SECRET=
ALCHEMY_WEBHOOK_SECRET_BASE=
ALCHEMY_WEBHOOK_SECRET_CELO=
ALCHEMY_ADDRESS_ACTIVITY_WEBHOOK_ID_BASE=
ALCHEMY_ADDRESS_ACTIVITY_WEBHOOK_ID_CELO=

# Point both Alchemy Address Activity webhooks at production:
#   https://fx-remit-pwa.vercel.app/api/alchemy/webhook
# (Not ngrok — local tunnels drop events when offline.)

# Paycrest
NEXT_PUBLIC_PAYCREST_API_KEY=
PAYCREST_API_KEY=
PAYCREST_SECRET_KEY=

# App
NEXT_PUBLIC_DEFAULT_CHAIN_ID=8453
NEXT_PUBLIC_FX_REMIT_ROUTER_ADDRESS=0x785a7A71642b68A87deBeEdBF2151C51501Fe408
SUSPENSE_WALLET_ADDRESS=

# Indexer / cron (required in Vercel production)
GOLDSKY_WEBHOOK_SECRET=
# Alias also accepted by the indexer route:
# GOLDSKY_WEBHOOK_SECRET_KEY=
# Goldsky sink URL must be production host, e.g. https://fx-remit.xyz/api/indexer/webhook
# (see goldsky.json — never leave your-pwa-url.com)
CRON_SECRET=
# Vercel cron Authorization: Bearer $CRON_SECRET → /api/cron/reconcile (daily 0 0 * * *)

# ---------------------------------------------------------------------------
# Web Push (Bell inbox + phone OS notifications)
# Generate: npx web-push generate-vapid-keys
# Put the public key in BOTH server and NEXT_PUBLIC so the client can subscribe.
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:team@fx-remit.xyz
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
