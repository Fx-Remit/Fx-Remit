# Copy to .env.local and fill values. Never commit secrets.

# Database
DATABASE_URL=
DIRECT_URL=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WEBHOOK_SECRET=
# Instant Send: authorization private key (wallet-auth:…) + matching key quorum / policy
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Client: key quorum id from Privy Dashboard (e.g. mi1bf…)
NEXT_PUBLIC_PRIVY_KEY_QUORUM_ID=
# Client: Instant Send USDC policy id (optional but recommended)
NEXT_PUBLIC_PRIVY_POLICY_ID=

# Alchemy RPC + Notify (Address Activity)
NEXT_PUBLIC_ALCHEMY_API_KEY=
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_SECRET=
ALCHEMY_WEBHOOK_SECRET_BASE=
ALCHEMY_WEBHOOK_SECRET_CELO=
ALCHEMY_ADDRESS_ACTIVITY_WEBHOOK_ID_BASE=
ALCHEMY_ADDRESS_ACTIVITY_WEBHOOK_ID_CELO=

# Point both Alchemy Address Activity webhooks at production:
#   https://fx-remit-pwa.vercel.app/api/alchemy/webhook
# (Not ngrok — local tunnels drop events when offline.)

# Paycrest
NEXT_PUBLIC_PAYCREST_API_KEY=
PAYCREST_API_KEY=
PAYCREST_SECRET_KEY=

# App
NEXT_PUBLIC_DEFAULT_CHAIN_ID=8453
NEXT_PUBLIC_FX_REMIT_ROUTER_ADDRESS=0x785a7A71642b68A87deBeEdBF2151C51501Fe408
SUSPENSE_WALLET_ADDRESS=

# Indexer / cron (required in Vercel production)
GOLDSKY_WEBHOOK_SECRET=
# Alias also accepted by the indexer route:
# GOLDSKY_WEBHOOK_SECRET_KEY=
# Goldsky sink URL must be production host, e.g. https://fx-remit.xyz/api/indexer/webhook
# (see goldsky.json — never leave your-pwa-url.com)
CRON_SECRET=
# Vercel cron Authorization: Bearer $CRON_SECRET → /api/cron/reconcile (daily 0 0 * * *)

# ---------------------------------------------------------------------------
# Stellar rail (sandbox / testnet). Off by default — does not affect EVM cash-out.
# Copy into .env.local; never commit real S... secrets.
# ---------------------------------------------------------------------------

# Master switch for /api/stellar/* and NEXT_PUBLIC stellar feature gates.
# Never enable on a public host together with STELLAR_TEST_SECRET without Privy + operator allowlist (#92).
NEXT_PUBLIC_STELLAR_ENABLED=false

# Browser: Freighter + Horizon network (testnet | public). Defaults to testnet if unset.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Server: SEP anchor routing (testnet | public). Defaults to testnet if unset.
STELLAR_NETWORK=testnet

# Dev-only server keypair for SEP-10/24 smoke scripts and withdraw/start without Freighter.
# Freighter users use POST /api/stellar/auth/challenge + /auth/token instead (no secret).
# Fund via Friendbot, then trustline to testanchor USDC (see packages/services/src/stellar/README.md).
# withdraw/start (secret path) and withdraw/pay require Authorization: Bearer <Privy JWT>
# AND that DID listed in STELLAR_TEST_OPERATOR_PRIVY_DIDS (#92). Empty allowlist → 403.
# STELLAR_TEST_SECRET=
# STELLAR_TEST_OPERATOR_PRIVY_DIDS=did:privy:your-operator-did

# Optional amount for stellar:sep24-test / sep24-pay-test (default 1)
# STELLAR_TEST_AMOUNT=1
# Resume pay after interactive KYC: STELLAR_SEP24_TX_ID=<anchor tx id>
# STELLAR_SEP24_TRANSFER_TIMEOUT_MS=300000
# STELLAR_SEP24_TERMINAL_TIMEOUT_MS=180000
