{
  "name": "fx-remit-mainnet-mirror",
  "version": "1.0.0",
  "description": "RemittanceIndexer only — RemittanceInitiated on Base + Celo FXRemit routers. Deposits use Alchemy Address Activity / DepositService.",
  "pipelines": [
    {
      "id": "base-remittance-mirror",
      "source": {
        "type": "event",
        "network": "base-mainnet",
        "address": "0x785a7A71642b68A87deBeEdBF2151C51501Fe408",
        "abi_path": "packages/shared-sdk/src/abi/FXRemitRouter.json",
        "event_name": "RemittanceInitiated",
        "start_block": "48793833"
      },
      "sink": {
        "type": "webhook",
        "url": "https://your-pwa-url.com/api/indexer/webhook",
        "secret_name": "GOLDSKY_WEBHOOK_SECRET_KEY"
      }
    },
    {
      "id": "celo-remittance-mirror",
      "source": {
        "type": "event",
        "network": "celo-mainnet",
        "address": "0x767B35703C98f63e71aB61d68a406931ADdb3FeB",
        "abi_path": "packages/shared-sdk/src/abi/FXRemitRouter.json",
        "event_name": "RemittanceInitiated",
        "start_block": "latest"
      },
      "sink": {
        "type": "webhook",
        "url": "https://your-pwa-url.com/api/indexer/webhook",
        "secret_name": "GOLDSKY_WEBHOOK_SECRET_KEY"
      }
    }
  ]
}
