{
  "name": "@fx-remit/services",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test src/paycrest/*.test.ts src/deposits/*.test.ts src/transactions/*.test.ts src/identity/*.test.ts src/reconciliation/*.test.ts src/evm/*.test.ts src/stellar/config/*.test.ts src/stellar/sep10/*.test.ts src/stellar/sep24/*.test.ts src/stellar/sep38/*.test.ts src/stellar/persist/*.test.ts",
    "stellar:sep10-test": "node --import tsx src/stellar/sep10/sep10-testnet.ts",
    "stellar:sep24-test": "node --import tsx src/stellar/sep24/sep24-testnet.ts",
    "stellar:sep38-test": "node --import tsx src/stellar/sep38/sep38-testnet.ts",
    "evm:paycrest-smoke": "node --import tsx --env-file=../../apps/pwa/.env.local src/evm/scripts/evm-paycrest-smoke.ts",
    "evm:webhook-smoke": "node --import tsx --env-file=../../apps/pwa/.env.local src/evm/scripts/evm-webhook-smoke.ts",
    "evm:sandbox-smoke": "node --import tsx --env-file=../../apps/pwa/.env.local src/evm/scripts/evm-sandbox-smoke.ts"
  },
  "dependencies": {
    "@fx-remit/database": "workspace:*",
    "@privy-io/node": "0.12.0",
    "@stellar/stellar-sdk": "^14.1.1",
    "@types/node": "^20.11.24",
    "axios": "^1.15.0",
    "decimal.js": "^10.6.0",
    "jsencrypt": "^3.5.4",
    "viem": "2.47.10"
  },
  "devDependencies": {
    "@types/decimal.js": "^7.4.3",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3"
  }
}
