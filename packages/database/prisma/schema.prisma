generator client {
  provider = "prisma-client-js"
  output   = "../generated-client"
}

datasource db {
  provider = "postgresql"
}

enum RemittanceRail {
  EVM
  STELLAR
}

model User {
  id               String        @id @default(uuid())
  privyDid         String        @unique @map("privy_did")
  walletAddress    String?       @unique @map("wallet_address")
  stellarPublicKey String?       @unique @map("stellar_public_key")
  fullName         String?       @map("full_name")
  email            String?       @unique
  avatarUrl        String?       @map("avatar_url")
  totalSentUsd     Decimal       @default(0.0) @map("total_sent_usd") @db.Decimal(36, 18)
  transactionCount Int           @default(0) @map("transaction_count")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  displayName      String?       @map("display_name")
  lastLoginAt      DateTime?     @map("last_login_at")
  walletBalance    Decimal       @default(0.0) @map("wallet_balance") @db.Decimal(36, 18)
  transactions      Transaction[]
  savedRecipients   SavedRecipient[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

enum NotificationType {
  DEPOSIT_CREDITED
  REMITTANCE_COMPLETED
  REMITTANCE_FAILED
}

model Notification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  type          NotificationType
  title         String
  body          String
  transactionId String           @map("transaction_id")
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, transactionId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum RecipientType {
  BANK
  MOBILE
}

model SavedRecipient {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  type              RecipientType @default(BANK)
  currency          String
  institutionCode   String        @map("institution_code")
  institutionName   String        @map("institution_name")
  accountIdentifier String        @map("account_identifier")
  accountName       String        @map("account_name")
  lastUsedAt        DateTime      @default(now()) @map("last_used_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, currency, institutionCode, accountIdentifier])
  @@index([userId, lastUsedAt(sort: Desc)])
  @@map("saved_recipients")
}

model Transaction {
  id                  String          @id @default(uuid())
  userId              String          @map("user_id")
  orderId             BigInt          @map("order_id")
  txHash              String          @map("tx_hash")
  rail                RemittanceRail  @default(EVM) @map("rail")
  stellarPaymentHash  String?         @unique @map("stellar_payment_hash")
  anchorTransactionId String?         @map("anchor_transaction_id")
  corridor            String?         @map("corridor")
  sourceToken   String          @map("source_token")
  amountUsd     Decimal         @map("amount_usd") @db.Decimal(36, 18)
  payoutFiat    Decimal         @map("payout_fiat") @db.Decimal(36, 18)
  status        Status          @default(PENDING)
  recipientName     String?         @map("recipient_name")
  recipientBank     String?         @map("recipient_bank")
  recipientAcc      String?         @map("recipient_acc")
  /** Paycrest institution code — required to reuse recipients without re-picking bank. */
  recipientBankCode String?         @map("recipient_bank_code")
  createdAt         DateTime        @default(now()) @map("created_at")
  blockNumber   BigInt          @map("block_number")
  chainId       Int             @map("chain_id")
  externalId    String?         @unique @map("external_id")
  logIndex      Int             @map("log_index")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  type          TransactionType @default(REMITTANCE)
  /** On-chain Paycrest crypto refund hash linked for ops (#90). Per-user unique. */
  refundTxHash  String?         @map("refund_tx_hash")
  user          User            @relation(fields: [userId], references: [id])

  @@unique([txHash, logIndex])
  @@unique([chainId, blockNumber, logIndex])
  @@unique([orderId, chainId])
  @@unique([userId, refundTxHash])
  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  REMITTANCE
}

enum Status {
  PENDING
  VERIFIED
  COMPLETED
  FAILED
  PROCESSING
  REFUNDING
  REFUND_REQUIRED
}
